{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site-plan.schema.json",
  "title": "Hosait Site Kit site plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "media",
    "pages",
    "settings"
  ],
  "definitions": {
    "ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "text": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "no",
          "en"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "block": {
      "type": "object",
      "required": [
        "blockType"
      ],
      "properties": {
        "blockType": {
          "type": "string",
          "$comment": "blockType",
          "enum": [
            "hero",
            "content",
            "textImage",
            "fullImage",
            "imageGrid",
            "cards",
            "childPages",
            "cta",
            "quote",
            "stats",
            "facts",
            "articleFeed",
            "people",
            "documents",
            "timeline",
            "accordion",
            "video",
            "embed",
            "formBlock"
          ]
        }
      },
      "additionalProperties": true
    },
    "navItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "page"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "page": {
          "$ref": "#/definitions/ref"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "site": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "cms": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "source"
        ],
        "properties": {
          "ref": {
            "$ref": "#/definitions/ref"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "$ref": "#/definitions/text"
          },
          "credit": {
            "type": "string"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "name"
        ],
        "properties": {
          "ref": {
            "$ref": "#/definitions/ref"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/definitions/text"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "image": {
            "$ref": "#/definitions/ref"
          },
          "bio": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "source",
          "title",
          "docType"
        ],
        "properties": {
          "ref": {
            "$ref": "#/definitions/ref"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "docType": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "description": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "title",
          "layout"
        ],
        "properties": {
          "ref": {
            "$ref": "#/definitions/ref"
          },
          "parent": {
            "$ref": "#/definitions/ref"
          },
          "isHome": {
            "type": "boolean"
          },
          "order": {
            "type": "number"
          },
          "hideFromNav": {
            "type": "boolean"
          },
          "cardImage": {
            "$ref": "#/definitions/ref"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "slug": {
            "$ref": "#/definitions/text"
          },
          "summary": {
            "$ref": "#/definitions/text"
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "no",
                "en"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "$media"
                  ],
                  "properties": {
                    "$media": {
                      "$ref": "#/definitions/ref"
                    }
                  }
                }
              }
            }
          },
          "layout": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "no",
                "en"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/block"
              }
            }
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "kind",
          "publishedAt",
          "title"
        ],
        "properties": {
          "ref": {
            "$ref": "#/definitions/ref"
          },
          "kind": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "heroImage": {
            "$ref": "#/definitions/ref"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "slug": {
            "$ref": "#/definitions/text"
          },
          "lead": {
            "$ref": "#/definitions/text"
          },
          "contentHtml": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nav"
      ],
      "properties": {
        "nav": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "no",
              "en"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/navItem"
            }
          }
        },
        "contact": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "no",
              "en"
            ]
          },
          "additionalProperties": {
            "$ref": "#/definitions/navItem"
          }
        },
        "footer": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "no",
              "en"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "links"
              ],
              "properties": {
                "heading": {
                  "type": "string"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "page": {
                        "$ref": "#/definitions/ref"
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^(https?://|mailto:|tel:)"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "copyright": {
          "$ref": "#/definitions/text"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "street": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          }
        }
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^/"
          },
          "toPage": {
            "$ref": "#/definitions/ref"
          },
          "toUrl": {
            "type": "string",
            "pattern": "^(https?://|/)"
          },
          "permanent": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "toPage"
            ]
          },
          {
            "required": [
              "toUrl"
            ]
          }
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceUrl",
          "section",
          "reason"
        ],
        "properties": {
          "sourceUrl": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
